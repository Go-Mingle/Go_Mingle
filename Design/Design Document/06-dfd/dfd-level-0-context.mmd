  SYS(("<b>0</b><br/>GoMingle<br/>platform")):::proc

  ADM -- "sign-in, approvals, interest tables,<br/>escrow actions, catalogue, templates" --> SYS
  SYS -- "queues, dashboards, finances,<br/>notifications, change log" --> ADM
  PAR -- "sign-up, profile, tables, menu,<br/>check-in, no-show, payout account" --> SYS
  SYS -- "status, bookings, guest list,<br/>finances, notifications" --> PAR
  MIN -. "account, bookings, card details" .-> SYS
  SYS -. "tables, confirmations, receipts" .-> MIN
  SYS -- "checkout, capture, void, refund" --> SPY
  SPY -- "payment state (tracker)" --> SYS
  SYS -- "rendered emails" --> EML
  EML -- "message id / error" --> SYS
  GGL -- "signed ID token, public keys" --> SYS
