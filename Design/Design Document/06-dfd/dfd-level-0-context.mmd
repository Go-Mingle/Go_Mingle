  ADM["Admin"]:::ext
  PAR["Restaurant partner"]:::ext
  MIN["Mingler<br/>(Mingler app, planned)"]:::ext
  SPY["Safepay"]:::ext
  EML["Email provider<br/>(Mailtrap / SMTP)"]:::ext
