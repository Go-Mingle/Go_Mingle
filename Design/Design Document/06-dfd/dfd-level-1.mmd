---
title: GoMingle – Data Flow Diagram, Level 1
---
flowchart LR
  classDef ext fill:#FFFFFF,stroke:#1F2937,stroke-width:1.5px,color:#1F2937
  classDef proc fill:#FFF1EF,stroke:#E8604F,stroke-width:2px,color:#1F2937
  classDef store fill:#EEF2FF,stroke:#4F46E5,color:#1F2937

  ADM["Admin"]:::ext
  PAR["Restaurant partner"]:::ext
  SPY["Safepay"]:::ext
  EML["Email provider"]:::ext
  GGL["Google Identity"]:::ext

  P1(("<b>1.0</b><br/>Authenticate &<br/>manage accounts")):::proc
  P2(("<b>2.0</b><br/>Onboard &<br/>review restaurants")):::proc
  P3(("<b>3.0</b><br/>Manage interest<br/>tables")):::proc
  P4(("<b>4.0</b><br/>Book, check in &<br/>record no-shows")):::proc
  P5(("<b>5.0</b><br/>Escrow &<br/>payouts")):::proc
  P6(("<b>6.0</b><br/>Notify<br/>(in-app & email)")):::proc
  P7(("<b>7.0</b><br/>Audit admin<br/>changes")):::proc

  D1[("D1 Accounts<br/>roles · admin_users · partner_users<br/>tokens · one-time codes")]:::store
  D2[("D2 Restaurants & venue<br/>restaurants · tables · menu ·<br/>media · payout_accounts")]:::store
  D3[("D3 Interest tables<br/>interest_tables · invitees")]:::store
  D4[("D4 Bookings")]:::store
  D5[("D5 Escrow<br/>escrow_holds · payment_failures")]:::store
  D6[("D6 Notifications & email<br/>notifications · email_templates · email_log")]:::store
  D7[("D7 Change log")]:::store
  D8[("D8 Catalogue & settings<br/>categories · amenities · topics ·<br/>interests · loyalty · policy")]:::store

  ADM -- "credentials" --> P1
  PAR -- "credentials / sign-up email" --> P1
  GGL -- "ID token" --> P1
  P1 <--> D1
  P1 -- "tokens, session" --> ADM
  P1 -- "tokens, session" --> PAR
  P1 -- "code request" --> P6

  PAR -- "profile, tables, menu, media" --> P2
  ADM -- "approve / decline / suspend" --> P2
  P2 <--> D2
  P2 -- "category" --- D8
  P2 -- "status change" --> P6

  ADM -- "table details, publish, cancel" --> P3
  P3 <--> D3
  D2 -- "tables, menu options" --> P3
  P3 -- "cancel table" --> P4

  ADM -- "sandbox booking" --> P4
  PAR -- "guests arrived, no-show" --> P4
  D3 -- "seats, start time" --> P4
  D8 -- "no-show policy" --> P4
  P4 <--> D4
  P4 -- "holds, bill, penalties, releases" --> P5
  P4 -- "events" --> P6

  ADM -- "capture, release, void, refund, retry" --> P5
  P5 <--> D5
  D2 -- "payout account, fee" --> P5
  P5 -- "checkout, capture, void, refund" --> SPY
  SPY -- "payment state" --> P5
  P5 -- "payout released" --> P6
  P5 -- "finances, escrow" --> ADM
  P5 -- "finances, escrow" --> PAR

  P6 <--> D6
  P6 -- "email" --> EML
  P6 -- "notifications" --> ADM
  P6 -- "notifications" --> PAR

  ADM -- "any change" --> P7
  P7 --> D7
  D7 -- "change log" --> ADM
