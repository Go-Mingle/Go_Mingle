# GoMingle API settings. Copy this file to ".env" (same folder) and fill it in.
# Restart the API after any change.

# ── Safepay ─────────────────────────────────────────────────────────
# From your Safepay sandbox dashboard (Developer → API keys).
# Leave both empty to use the built-in simulator.
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=

# GoMingle's cut when escrow is released to a restaurant (percent).
PLATFORM_FEE_PCT=10

# ── Optional ────────────────────────────────────────────────────────
# Keeps people signed in across API restarts (any long random string).
# JWT_SECRET=
