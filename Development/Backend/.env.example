# GoMingle server settings. Copy this file to ".env" (same folder) and fill it in.
# Restart the server after any change. Never commit ".env".

# ── Server ──────────────────────────────────────────────────────────
# PORT=4000
# Address the browser reaches this server on (used in upload and media links).
# PUBLIC_URL=http://localhost:4000
# Keeps people signed in across restarts (any long random string).
JWT_SECRET=

# ── Database ────────────────────────────────────────────────────────
# Leave empty to use the built-in PostgreSQL (files in ./data, nothing to install).
# Set it to use your own PostgreSQL or AWS RDS:
#   DATABASE_URL=postgres://user:password@host:5432/gomingle
DATABASE_URL=
# Port of the built-in PostgreSQL (only used when DATABASE_URL is empty).
# EMBEDDED_DB_PORT=5433

# ── Safepay ─────────────────────────────────────────────────────────
# From your Safepay dashboard (Developer → API keys).
# Leave both keys empty to use the built-in simulator.
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=

# GoMingle's cut when escrow is released to a restaurant (percent).
PLATFORM_FEE_PCT=10

# ── Email ───────────────────────────────────────────────────────────
# Leave all empty to print emails in this window instead of sending them.
# Mailtrap: API token from Mailtrap → Settings → API Tokens. With an inbox id,
# emails land in that Mailtrap test inbox; without one, Mailtrap sends for real.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
# Or any SMTP provider (Brevo, Amazon SES, …):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM_EMAIL=no-reply@gomingle.com
MAIL_FROM_NAME=GoMingle
# Links in emails.
# ADMIN_PORTAL_URL=http://localhost:5173
# PARTNER_PORTAL_URL=http://localhost:5174
# A fixed code accepted with the real one; on by default only while no email
# provider is set.
# DEMO_OTP=123456

# ── Google sign-in (Partner Portal) ─────────────────────────────────
# OAuth client id from Google Cloud → Credentials. Empty turns it off.
GOOGLE_CLIENT_ID=
